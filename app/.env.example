# 로컬 개발용 예시. 복사해서 .env 로 쓰고(커밋 금지), EAS 빌드에는 `eas env:create` 로 같은 이름을 등록한다.
# EXPO_PUBLIC_* 는 앱 번들에 그대로 들어가는 공개값이다. 비밀 키를 넣지 않는다.

# Supabase (공개 anon/publishable 키만. service_role/secret 키 금지)
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 문항 팩 매니페스트 URL(기본: <SUPABASE_URL>/storage/v1/object/public/media/bank/latest/manifest.json)
EXPO_PUBLIC_BANK_MANIFEST_URL=

# RevenueCat 공개 SDK 키(플랫폼별)
EXPO_PUBLIC_RC_IOS_KEY=
EXPO_PUBLIC_RC_ANDROID_KEY=
# 결제 화면: custom(기본, 앱이 고지문과 상품을 직접 그림) | revenuecat(대시보드 Paywall 사용)
EXPO_PUBLIC_PAYWALL_MODE=custom

# 정책 링크·문의
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=

# 빌드 시점(app.config.ts)
EAS_PROJECT_ID=
APP_ANDROID_PACKAGE=kr.hamjeongnote.app
APP_IOS_BUNDLE_ID=kr.hamjeongnote.app
APP_LINK_DOMAIN=
