# Supabase Edge Function 비밀값 예시 — 복사해서 supabase/functions/.env 로 쓰고(커밋 금지) 값을 채운다.
#   로컬:  supabase functions serve --env-file supabase/functions/.env
#   원격:  supabase secrets set --env-file supabase/functions/.env   (또는 bash scripts/supabase_deploy.sh <project-ref>)
# SUPABASE_ 로 시작하는 이름은 쓸 수 없다(SUPABASE_URL·서버 키는 Supabase 가 자동으로 넣는다).
# 자세한 설명: docs/SETUP.md#supabase-functions · docs/SETUP.md#revenuecat

# RevenueCat 대시보드 웹훅의 Authorization header 칸에 넣은 값과 똑같이(아무 긴 무작위 문자열)
REVENUECAT_WEBHOOK_AUTH=
# 클릭 IP 를 해시할 때 섞는 무작위 문자열(한 번 정하면 바꾸지 않는다 — 바꾸면 같은 사람도 다른 해시가 됨)
IP_HASH_SALT=
# 안드로이드 패키지명(예: kr.example.app) — 없으면 Play 스토어로 보내지 않는다
ANDROID_PACKAGE=
# App Store 앱 ID(숫자) — 출시 전이면 비워 둔다
IOS_APP_ID=
# App Store Connect → 앱 분석 → 캠페인 링크의 pt 값(숫자)
APPLE_PROVIDER_TOKEN=
# PC 등 스토어가 없는 기기에서 보낼 소개 페이지(https://...) — 없으면 Play 스토어 웹 페이지로 보낸다
LANDING_URL=
